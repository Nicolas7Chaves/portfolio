// Cloudflare Workers config: serves the Vite build output as static assets.
// Deploys run `npm run build` then `npx wrangler deploy` on every push to main.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  }
}
